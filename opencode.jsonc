          ".git/**": "deny",
          ".github/**": "deny"
        },
      },
      "color": "#ff6b6b"
    },
    "worker_gemma_Q4_128K": {
      "description": "moderately intelligent, speedrating 160-200, 128k context, lower pecision, lower to medium general knowledge: needs explicit step by step guidance, should do no coding",
      "mode": "all",
      "model": "llama-swap/Gemma4-12B-Q4KXL-MTP-128K",
      "prompt": "{file:./.opencode/agent/prompts/agents/prompt_agent_task.md}",
      "temperature": 0.6,
      "permission": {
