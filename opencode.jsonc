{
  // config.json is for desktop app, tui.json for TUI ^^
  // https://opencode.ai/docs/config/
  "$schema": "https://opencode.ai/tui.json",
  "autoupdate": false,
  "formatter": true,
  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true
  },
  "diff_style": "auto",
  "cursor": {
    "style": "block",
    "blinking": false
  },
  "mouse": true,
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.5
  },
  "permission": {
    // as basis for sandboxing, so the base paths that are possible to correct to are known
    "external_directory": {
      "C:/Users/Wasiejen/Projects/OpenCodeProjects/Free-Snap-Tap/Free-Snap-Tap": "allow",
      "C:/Users/Wasiejen/AppData/Local/Temp/opencode": "allow",
      "C:/Users/Wasiejen/.local/share/opencode/log": "allow",
      "C:/Users/Wasiejen/AppData/Roaming/npm": "allow",
      "C:/Users/Wasiejen/AppData/Roaming/npm/**": "allow",
      "C:/Users/Wasiejen/AppData/Roaming/npm/node_modules/opencode-ai/**": "allow"
      // db path still to add or better in watcher ignore?
    }
  },
  "references": {
    "scratchpad": {
      "path": "C:/Users/Wasiejen/AppData/Local/Temp/opencode",
      "description": "Local windows temporary directory for intermediate agent outputs"
    }
  },
  // test to see if this is still triggering a rejection
  "watcher": {
    "ignore": ["C:/Users/Wasiejen/AppData/Local/Temp/**", "C:/Users/Wasiejen/AppData/Local/Temp/"]
  },
  // automatic revert of git changes on revert in session via TUI -> caused a lot of origin mismatches
  "snapshots": false,
  "compaction": {
    "auto": false,
    //"prune": false,
    //"reserved": 10000,
    "keep": {
      "system": true,
    // 2026-09-25_14-05: messages are ignored by V2 summerize -> only keepToken is respected
      "tokens": 30000,
      "messages": 22
    },
    "buffer": 2000
  },
  "shell": "C:/Program Files/Git/bin/bash.exe",
  "provider": {
    "llama-swap": {
      "name": "llama-swap-v2",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.178.20:8033/v1"
      },
      "models": {
        // -------------------
        // ik_llama.cpp backend with hadamard kv and optional trellis weights
        // -------------------
        // "Qwen3.8-27B-Q2S-210K-MTP": {
        //   "name": "Qwen3.8-27B-Q2S-MTP",
        //   "limit": {
        //     "context": 210000,
        //     "output": 210000
        //   }
        // },
        // "Qwen3.8-27B-Q2S-128K-x2": {
        //   "name": "Qwen3.8-27B-Q2S-2Slots",
        //   "limit": {
        //     "context": 128000,
        //     "output": 128000
        //   }
        // },
        "Qwen3.8-27B-Q3S-160K-MTP-Thireus": {
          "name": "Qwen3.8-27B-Q3S-MTP-Bee",
          "limit": {
            "context": 160000,
            "output": 160000
          }
        },
        // -------------------
        // beellama.cpp backend with kvarn kv cache
        // -------------------
        "Qwen3.8-27B-Q3S-140K-HQKV": {
          "name": "Qwen3.8-27B-Q3S-HQKV",
          "limit": {
            "context": 140000,
            "output": 140000
          }
        },
        "Qwen3.8-27B-Q3S-170K": {
          "name": "Qwen3.8-27B-Q3S",
          "limit": {
            "context": 170000,
            "output": 170000
          }
        },
        "Qwen3.8-27B-Q3S-245K-slow": {
          "name": "Qwen3.8-27B-Q3S-slow",
          "limit": {
            "context": 245000,
            "output": 245000
          }
        },
        "Qwen3.8-27B-Q3XS-262K": {
          "name": "Qwen3.8-27B-Q3XS",
          "limit": {
            "context": 262144,
            "output": 262144
          }
        },
        "Qwen3.8-27B-Compaction": {
          "name": "Qwen3.8-27B-Compaction",
          "limit": {
            "context": 135000,
            "output": 135000
          }
        },
        // -------------------
        // mainstream llama.cpp
        // -------------------
        "Gemma4-12B-Q4KM-UC-128K": {
          "name": "Gemma4-12B-Q4KM-UC",
          "limit": {
            "context": 262144,
            "output": 262144
          }
        },
        "Gemma4-12B-Q4KXL-MTP-128K": {
          "name": "Gemma4-12B-Q4KXL-MTP",
          "limit": {
            "context": 131072,
            "output": 131072
          }
        },
        // "CPU-Qwen3-0.6B": {
        //   "name": "CPU-Qwen3-0.6B",
        //   "limit": {
        //     "context": 32000,
        //     "output": 32000
        //   }
        // },
        // "CPU-Gemma4-E2B": {
        //   "name": "CPU-Gemma4-E2B",
        //   "limit": {
        //     "context": 32000,
        //     "output": 32000
        //   }
        // },
        // "CPU-Qwen3.5-4B": {
        //   "name": "CPU-Qwen3.5-4B",
        //    "limit": {
        //     "context": 16384,
        //     "output": 16384
        //   }
        // }
      }
    }
  },
  "subagent_depth": 2,
  "default_agent": "planner_Q3S_170K",
  "agent": {
