{
  "$schema": "https://opencode.ai/config.json",
  // "plugins": [
  //   "./.opencode/plugin/context_recovery.ts",
  //   "./.opencode/tools/compact_memory.ts",
  //   "./.opencode/tools/block_transfer.ts"
  // ],
  // "tools": {
  //   "block_transfer": true,
  //   "compact_memory": true
  // },
  "compaction": {
    "auto": false,
      "keep": {
        "system": true,
        "tokens": 30000,
        "messages": 12
    },
    "buffer": 2000
  },

  "provider": {
    "llama-swap": {
      "name": "llama-swap-v2",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.178.20:8033/v1"
      },
      "models": {
        "Qwen3.8-27B-IQ4KT-120K:chat": {
          "name": "Qwen3.8-27B-IQ4KT:chat",
          "limit": {
            "context": 120000,
            "output": 120000
          }
        },
        "Qwen3.8-27B-IQ3KT-120K_MTP": {
          "name": "Qwen3.8-27B-IQ3KT-MTP",
          "limit": {
            "context": 120000,
            "output": 120000
          }
        },
        "Qwen3.8-27B-IQ3KT-210K": {
          "name": "Qwen3.8-27B-IQ3KT",
          "limit": {
            "context": 210000,
            "output": 131072
          }
        },
        "Qwen3.8-27B-IQ3KP-UC-100K": {
          "name": "Qwen3.8-27B-IQ3KP-UC",
          "limit": {
            "context": 100000,
            "output": 10000
          }
        },
        "Qwen3.8-27B-IQ4KT-50K-MTP": {
          "name": "Qwen3.8-27B-IQ4KT-MTP",
          "limit": {
            "context": 50000,
            "output": 50000
          }
        },
        "Qwen3.8-27B-IQ4KT-120K": {
          "name": "Qwen3.8-27B-IQ4KT",
          "limit": {
            "context": 120000,
            "output": 120000
          }
        },
        "Gemma4-12B-Q4KM-UC-256K": {
          "name": "Gemma4-12B-Q4KM-UC",
          "limit": {
            "context": 131072,
            "output": 131072
          }
        },
        "Gemma4-12B-Q4KXL-MTP-256K": {
          "name": "Gemma4-12B-Q4KXL-MTP",
          "limit": {
            "context": 131072,
            "output": 131072
          }
        },
        "CPU-Qwen3-0.6B": {
          "name": "CPU-Qwen3-0.6B",
          "limit": {
            "context": 32000,
            "output": 32000
          }
        },
        "CPU-Gemma4-E2B": {
          "name": "CPU-Gemma4-E2B",
          "limit": {
            "context": 32000,
            "output": 32000
          }
        },
        "CPU-Qwen3.5-4B": {
          "name": "CPU-Qwen3.5-4B",
           "limit": {
            "context": 16384,
            "output": 16384
           }
        }
      }
    }
  },
  "references": {
      "scratchpad": {
        "path": "C:/Users/Wasiejen/AppData/Local/Temp/opencode",
        "description": "Local windows temporary directory for intermediate agent outputs"
      }
    },
  "subagent_depth": 2,
  "agent": {
    "looprunner_Q4_120k": {
      "description": "Just restarts the Planner in autnomous mode, same model als planner_Q4_120K for fast switching",
      "mode": "primary",
      "model": "llama-swap/Qwen3.8-27B-IQ4KT-120K:chat",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/system_prompts/agents/prompt_agent_looprunner.md}",
      "tools": {
          "read_file": true,
          "list_dir": true,
          "glob": true
        },
      "permission": {
        "*": "deny",
        "task": "allow",
        "read": {
          ".opencode/loop/*": "allow",
          ".opencode/loop": "allow",
          ".opencode/archive/loop/*": "allow",
          ".opencode/archive/loop": "allow",
          ".opencode/system_prompts/agent_readme_loop.md": "allow"
        },
      },
      "options": {
        "load_project_docs": false,
        "load_agents_md": false,
        "load_workspace_tree": false
      }
    },
    "planner_Q3_120k_mtp": {
      "description": "intelligent, fast, 120k context, plans tasks and delegates to sub-agents, medium precision due to 3bit Quant",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-IQ3KT-120K_MTP",
      "temperature": 1.0,
      "prompt": "{file:./.opencode/system_prompts/agents/prompt_agent_planner.md}",
      "permission": {
        "edit": {
          "*": "allow",
          ".git/**": "deny",
          ".github/**": "deny"
        },
        "bash": "allow",
        "webfetch": "allow"
      }
    },
    "planner_Q4_120K": {
      "description": "half prefill, very intelligent, moderately fast, 120k context, plans tasks and delegates to sub-agents, higher precision and higher stability due to 4bit Quant",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-IQ4KT-120K",
      "prompt": "{file:./.opencode/system_prompts/agents/prompt_agent_planner.md}",
      "temperature": 1.0,
      "permission": {
        "task": "allow",
        "edit": {
          "*": "allow",
          ".git/**": "deny",
          ".github/**": "deny"
        },
        "bash": "allow",
        "webfetch": "allow"
      },
      "color": "accent"
    },

    "worker_explorer_Q3_120K_mtp": {
      "description": "intelligent, fast generation, 120K context window, to be used to explore code base - to be checked",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-IQ3KT-120K_MTP",
      "prompt": "{file:./.opencode/system_prompts/agents/prompt_agent_explorer.md}",
      "temperature": 1.0,
      "permission": {
        "edit": {
          "*": "deny",
          "C:/Users/Wasiejen/AppData/Local/Temp/opencode" : "allow",
          ".opencode/handover_task_to_planner.md": "allow",
          "TODO.md": "allow"
        },
        "bash": "allow",
        "webfetch": "allow"
      },
      "color": "accent"
    },

    "worker_Q3_120K_mtp": {
      "description": "intelligent, fast, 120k context, medium precision due to 3bit Quant",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-IQ3KT-120K_MTP",
      "prompt": "{file:./.opencode/system_prompts/agents/prompt_agent_task.md}",
      "temperature": 0.3,
      "permission": {
        "task": "allow",
        "edit": {
          "*": "allow",
          "C:/Users/Wasiejen/AppData/Local/Temp/opencode" : "allow",
          "AGENTS.md": "deny",
          "agents_repo.md": "deny",
          ".opencode/prompt_**": "deny",
          ".opencode/handover_planner.md": "deny",
          ".git/**": "deny",
          ".github/**": "deny"
        },
        "bash": "allow",
        "webfetch": "allow"
      },
      "color": "accent"
    },
    "worker_Q4_120K": {
      "description": "half prefill, very intelligent, moderately fast, 120k context, higher precision and higher stability due to 4bit Quant",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-IQ4KT-120K",
      "prompt": "{file:./.opencode/system_prompts/agents/prompt_agent_task.md}",
      "temperature": 1.0,
      "permission": {
        "task": "allow",
        "edit": {
          "*": "allow",
          "C:/Users/Wasiejen/AppData/Local/Temp/opencode" : "allow",
          "AGENTS.md": "deny",
          "agents_repo.md": "deny",
          ".opencode/prompt_**": "deny",
          ".opencode/handover_planner.md": "deny",
          ".git/**": "deny",
          ".github/**": "deny"
        },
        "bash": "allow",
        "webfetch": "allow"
      },
      "color": "accent"
    },
    "worker_Q3_210K": {
      "description": "intelligent, slow, big 210k context - for very long and complex tasks, medium precision due to 3bit Quant",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-IQ3KT-210K",
      "prompt": "{file:./.opencode/system_prompts/agents/prompt_agent_task.md}",
      "temperature": 0.3,
      "permission": {
        "task": "allow",
        "edit": {
          "*": "allow",
          "C:/Users/Wasiejen/AppData/Local/Temp/opencode" : "allow",
          "AGENTS.md": "deny",
          "agents_repo.md": "deny",
          ".opencode/prompt_**": "deny",
          ".opencode/handover_planner.md": "deny",
          ".git/**": "deny",
          ".github/**": "deny"
        },
        "bash": "allow",
        "webfetch": "allow"
      },
      "color": "accent"
    },
    "agent_Q3_210K": {
      "description": "intelligent, slow, big 210k context - for very long and complex tasks, no worker prompt, medium precision due to 3bit Quant",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-IQ3KT-210K",
      "prompt": "",
      "temperature": 1.0,
      "permission": {
        "task": "allow",
        "edit": {
          "*": "allow",
          "C:/Users/Wasiejen/AppData/Local/Temp/opencode" : "allow",
          "AGENTS.md": "deny",
          "agents_repo.md": "deny",
          ".opencode/prompt_**": "deny",
          ".opencode/handover_planner.md": "deny",
          ".git/**": "deny",
          ".github/**": "deny"
        },
        "bash": "allow",
        "webfetch": "allow"
      },
      "color": "#ff6b6b"
    },


    "agent_Q3_120K_mtp": {
      "description": "intelligent, fast, 120k context, no worker prompt, medium precision due to 3bit Quant",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-IQ3KT-120K_MTP",
      "prompt": "",
      "temperature": 1.0,
      "permission": {
        "task": "allow",
        "edit": {
          "*": "allow",
          "C:/Users/Wasiejen/AppData/Local/Temp/opencode" : "allow",
          "AGENTS.md": "deny",
          "agents_repo.md": "deny",
          ".opencode/prompt_**": "deny",
          ".opencode/handover_planner.md": "deny",
          ".git/**": "deny",
          ".github/**": "deny"
        },
        "bash": "allow",
        "webfetch": "allow"
      },
      "color": "#ff6b6b"
    },
    "agent_Q4_120K": {
      "description": "half prefill, very intelligent, moderately fast, 120k context, no worker prompt, higher precision and higher stability due to 4bit Quant",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-IQ4KT-120K",
      "prompt": "",
      "temperature": 1.0,
      "permission": {
        "task": "allow",
        "edit": {
          "*": "allow",
          "C:/Users/Wasiejen/AppData/Local/Temp/opencode" : "allow",
          "AGENTS.md": "deny",
          "agents_repo.md": "deny",
          ".opencode/prompt_**": "deny",
          ".opencode/handover_planner.md": "deny",
          ".git/**": "deny",
          ".github/**": "deny"
        },
        "bash": "allow",
        "webfetch": "allow"
      },
      "color": "#ff6b6b"
    },
    "agent_Q4_50K_MTP": {
      "description": "half prefill, very intelligent, fast, small 50k context, no worker prompt, higher precision and higher stability due to 4bit Quant",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-IQ4KT-50K-MTP",
      "prompt": "",
      "temperature": 1.0,
      "permission": {
        "task": "allow",
        "edit": {
          "*": "allow",
          "C:/Users/Wasiejen/AppData/Local/Temp/opencode" : "allow",
          "AGENTS.md": "deny",
          "agents_repo.md": "deny",
          ".opencode/prompt_**": "deny",
          ".opencode/handover_planner.md": "deny",
          ".git/**": "deny",
          ".github/**": "deny"
        },
        "bash": "allow",
        "webfetch": "allow"
      },
      "color": "#ff6b6b"
    },
    "agent_TempOnly": {
      "description": "Agent for testing, only has edit access to the TMP folder (C:/Users/Wasiejen/AppData/Local/Temp/opencode)",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-IQ4KT-120K",
      "prompt": "You only have acces to C:/Users/Wasiejen/AppData/Local/Temp/opencode (env variable TMP or TEMP)",
      "temperature": 1.0,
      "tools" : {
        "read_file" : true,
        "write_file": true,
        "list_dir": true,
        "glob": true
      },
      "permission": {
        "edit": {
          "C:/Users/Wasiejen/AppData/Local/Temp/opencode" : "allow",
        }
      },
      "options": {
        "load_project_docs": false,
        "load_agents_md": false
      },
      "color": "#222222"
    },
  }
}


