{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [],
  // needs to be tested
  "compaction": {
    "auto": false,
    "keep": {
      // how much of the original prompt to keep, default 15000
      "tokens": 60000,
    },
    // how close to the defined limit is allowed, default 20000
    // there seems to be no option to set buffer per model like the limit
    // might hack it via defining another limit then the modell actuall has
  // buffer : 0 not working == deactivated -> default?
    "buffer": 2000,
  },

  "provider": {
    "llama-swap": {
      "name": "llama-swap-v2",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.178.20:8033/v1"
      },
      "models": {
        "Qwen3.8-27B-IQ3KT-120K_MTP:chat": {
          "name": "Qwen3.8-27B-IQ3KT-MTP:chat",
          "limit": {
            "context": 120000,
            "output": 120000, // 131072 normally but adapted to contextsize
          }
        },
        "Qwen3.8-27B-IQ3KT-120K_MTP": {
          "name": "Qwen3.8-27B-IQ3KT-MTP",
          "limit": {
            "context": 120000,
            "output": 120000,
          }
        },
        "Qwen3.8-27B-IQ3KT-210K": {
          "name": "Qwen3.8-27B-IQ3KT",
          "limit": {
            "context": 210000,
            "output": 131072,
          }
        },
        "Qwen3.8-27B-IQ3KP-UC-100K": {
          "name": "Qwen3.8-27B-IQ3KP-UC",
          "limit": {
            "context": 100000,
            "output": 10000,
          }
        },
        "Qwen3.8-27B-IQ4KT-50K-MTP": {
          "name": "Qwen3.8-27B-IQ4KT-MTP",
          "limit": {
            "context": 50000,
            "output": 50000,
          }
        },
        "Qwen3.8-27B-IQ4KT-120K": {
          "name": "Qwen3.8-27B-IQ4KT",
          "limit": {
            "context": 120000,
            "output": 120000,
          }
        },
        "Gemma4-12B-Q4KM-UC-256K": {
          "name": "Gemma4-12B-Q4KM-UC",
          "limit": {
            "context": 131072,
            "output": 131072,
          }
        },
        "Gemma4-12B-Q4KXL-MTP-256K": {
          "name": "Gemma4-12B-Q4KXL-MTP",
          "limit": {
            "context": 131072,
            "output": 131072,
          }
        },
        "CPU-Qwen3-0.6B": {
          "name": "CPU-Qwen3-0.6B",
          // "limit": {
          // "context":
          // "output": 32000,
          // }
        },
        "CPU-Gemma4-E2B": {
          "name": "CPU-Gemma4-E2B",
          // "limit": {
          // "context":
          // "output": 32000,
          // }
        },
        "CPU-Qwen3.5-4B": {
          "name": "CPU-Qwen3.5-4B",
           "limit": {
            "context": 16384,
            "output": 16384,
           }
        }
      }
    }
  },
  "references": {
      "scratchpad": {
        "path": "C:/Users/Wasiejen/AppData/Local/Temp/opencode",
        "description": "Local windows temporary directory for intermediate agent outputs"
      }
    },
  "subagent_depth": 2,
  "agent": {
    // "clean looprunner_dump": {
    //   "description": "very simple looprunner without agents.md and limited contextsize and limited intelligence",
    //   "mode": "primary",
    //   "model": "llama-swap/CPU-Qwen3.5-4B",
