    "planner_Q3S_170K": {
      "description": "plans tasks and delegates to sub-agents: very high intelligence, speedrating 60, 170k context, high precision, highest general knowledge",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-Q3S-170K",
      "prompt": "{file:./.opencode/agent/prompts/agents/prompt_agent_planner.md}\n{file:.opencode/agent/memory/planner/destilled_mem.md}",
      // "prompt": "{file:./prompts/base.txt}\n{file:./prompts/rules.txt}\n{file:./prompts/examples.txt}"
      "temperature": 1.0,
      "permission": {
        "task": "allow",
        "edit": {
          "*": "allow",
          ".git/**": "deny",
          ".github/**": "deny"
        },
        "bash": "allow",
        "webfetch": "allow"
      },
      "color": "accent"
    },
