      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-Q3S-170K",
      "prompt": "{file:./.opencode/agent/prompts/roles/prompt_engineer.md}",
      "temperature": 1.0,
      "permission": {
        "task": "allow",
        "edit": {
          "*": "allow",
          "C:/Users/Wasiejen/AppData/Local/Temp/opencode" : "allow",
