    //     },
    //     "permission": {
    //       "*": "deny",
    //       "task": "allow",
    //       "read": {
    //         ".opencode/*": "allow",
    //         ".opencode": "allow"
    //       }
    //     },
    //   "options": {
    //     "load_project_docs": false,
    //     "load_agents_md": false,
    //     "load_workspace_tree": false
    //   }
    // },
    "looprunner_Q4_120k": {
      "description": "Just restarts the Planner in autnomous mode, same model als planner_Q4_120K for fast switching",
      "mode": "primary",
      "model": "llama-swap/Qwen3.8-27B-IQ4KT-120K",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/system_prompts/agents/prompt_agent_looprunner.md}",
      "tools": {
          "read_file": true,
          "write_file": true,
          "list_dir": true,
          "glob": true
        },
        "permission": {
          "*": "deny",
          "task": "allow",
          "read": {
            ".opencode/loop/*": "allow",
            ".opencode/loop": "allow",
            ".opencode/archive/loop/*": "allow",
            ".opencode/archive/loop": "allow"
          },
          "write": {
            ".opencode/loop/*": "allow",
            ".opencode/loop": "allow",
            ".opencode/archive/loop/*": "allow",
            ".opencode/archive/loop": "allow"
          }
        },
      "options": {
        "load_project_docs": false,
        "load_agents_md": false,
        "load_workspace_tree": false
      }
    },

    "planner_Q3_120k_mtp": {
      "description": "intelligent, fast, 120k context, plans tasks and delegates to sub-agents, medium precision due to 3bit Quant",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-IQ3KT-120K_MTP",
      "temperature": 1.0,
      "prompt": "{file:./.opencode/system_prompts/agents/prompt_agent_planner.md}",
      "permission": {
        "edit": {
          "*": "allow",
          ".git/**": "deny",
          ".github/**": "deny"
        },
        "bash": "allow",
        "webfetch": "allow"
      }
    },
    "planner_Q4_120K": {
      "description": "half prefill, very intelligent, moderately fast, 120k context, plans tasks and delegates to sub-agents, higher precision and higher stability due to 4bit Quant",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-IQ4KT-120K",
      "prompt": "{file:./.opencode/system_prompts/agents/prompt_agent_planner.md}",
      "temperature": 1.0,
      // "steps": 15,
      "permission": {
        "task": "allow",
        "edit": {
          "*": "allow",
          ".git/**": "deny",
          ".github/**": "deny"
        },
        "bash": "allow",
        "webfetch": "allow"
      },
      "color": "accent"
    },

    "worker_explorer_Q3_120K_mtp": {
      "description": "intelligent, fast generation, 120K context window, to be used to explore code base - to be checked",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-IQ3KT-120K_MTP",
      "prompt": "{file:./.opencode/system_prompts/agents/prompt_agent_explorer.md}",
      "temperature": 1.0,
      // "steps": 15,
      "permission": {
        "edit": {
          "*": "deny",
          "C:/Users/Wasiejen/AppData/Local/Temp/opencode" : "allow",
          ".opencode/handover_task_to_planner.md": "allow",
          "TODO.md": "allow",
        },
        "bash": "allow",
        "webfetch": "allow"
      },
      "color": "accent"
    },

