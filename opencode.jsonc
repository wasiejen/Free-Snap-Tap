{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [],
  "provider": {
    "llama-swap": {
      "name": "llama-swap-v2",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.178.20:8033/v1"
      },
      "models": {
        "Qwen3.8-27B-IQ3KT-120K_MTP:chat": {
          "name": "Qwen3.8-27B-IQ3KT-MTP:chat"
        },
        "Qwen3.8-27B-IQ3KT-120K_MTP": {
          "name": "Qwen3.8-27B-IQ3KT-MTP"
        },
        "Qwen3.8-27B-IQ3KT-210K": {
          "name": "Qwen3.8-27B-IQ3KT"
        },
        "Qwen3.8-27B-IQ3KP-UC-100K": {
          "name": "Qwen3.8-27B-IQ3KP-UC"
        },
        "Qwen3.8-27B-IQ4KT-50K-MTP": {
          "name": "Qwen3.8-27B-IQ4KT-MTP"
        },
        "Qwen3.8-27B-IQ4KT-120K": {
          "name": "Qwen3.8-27B-IQ4KT"
        },
        "Gemma4-12B-Q4KM-UC-256K": {
          "name": "Gemma4-12B-Q4KM-UC"
        },
        "Gemma4-12B-Q4KXL-MTP-256K": {
          "name": "Gemma4-12B-Q4KXL-MTP"
        },
        "CPU-Qwen3-0.6B": {
          "name": "CPU-Qwen3-0.6B"
        },
        "CPU-Gemma4-E2B": {
          "name": "CPU-Gemma4-E2B"
        },
        "CPU-Qwen3.5-4B": {
          "name": "CPU-Qwen3.5-4B"
        }
      }
    }
  },
  "references": {
      "scratchpad": {
        "path": "C:/Users/Wasiejen/AppData/Local/Temp/opencode",
        "description": "Local windows temporary directory for intermediate agent outputs"
      }
    },

  "agent": {
    "looprunner_Q4_120k": {
      "description": "Just restarts the Planenr in autnomous mode, same model als planner_Q4_120K for fast switching",
      "mode": "primary",
      "model": "llama-swap/Qwen3.8-27B-IQ4KT-120K",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/prompt_looprunner.md}",
      "permission": {
        "task": "allow",
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny"
      }
    },

    "planner_Q3_120k_mtp": {
      "description": "intelligent, fast, 120k context, plans tasks and delegates to sub-agents, medium precision due to 3bit Quant",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-IQ3KT-120K_MTP",
      "temperature": 1.0,
      "prompt": "{file:./.opencode/prompt_agent_planner.md}",
      "permission": {
        "edit": {
          "*": "allow",
          ".git/**": "deny",
          ".github/**": "deny"
        },
        "bash": "allow",
        "webfetch": "allow"
      }
    },
    "planner_Q4_120K": {
      "description": "half prefill, very intelligent, moderately fast, 120k context, plans tasks and delegates to sub-agents, higher precision and higher stability due to 4bit Quant",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-IQ4KT-120K",
      "prompt": "{file:./.opencode/prompt_agent_planner.md}",
      "temperature": 1.0,
      // "steps": 15,
      "permission": {
        "task": "allow",
        "edit": {
          "*": "allow",
          ".git/**": "deny",
          ".github/**": "deny"
        },
        "bash": "allow",
        "webfetch": "allow"
      },
      "color": "accent"
    },

    "worker_explorer_jill_gemma_256K_mtp": {
      "description": "moderately intelligent, very fast prefill (reading), very very fast generation, 256K context window, to be used to explore code base - but might lack in detail, so to be checked",
      "mode": "all",
      "model": "llama-swap/Gemma4-12B-Q4KXL-MTP-256K",
      "prompt": "{file:./.opencode/prompt_agent_explorer.md}",
      "temperature": 0.6,
      // "steps": 15,
      "permission": {
        "edit": {
          "*": "deny",
          "C:/Users/Wasiejen/AppData/Local/Temp/opencode" : "allow",
          ".opencode/handover_task_to_planner.md": "allow",
          "TODO.md": "allow",
        },
        "bash": "allow",
        "webfetch": "allow"
      },
      "color": "accent"
    },

    "worker_gemma_256k_mtp": {
      "description": "moderately intelligent, very very fast, 256K context window - needs concrete instructions, best for webfetch, big file reads, big writes",
      "mode": "all",
      "model": "llama-swap/Gemma4-12B-Q4KXL-MTP-256K",
      "prompt": "{file:./.opencode/prompt_agent_task.md}",
      "temperature": 0.2,
