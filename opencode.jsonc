{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": { // as basis for sandboxing, so the base paths that are possible to correct to are known
      "C:/Users/Wasiejen/Projects/OpenCodeProjects/Free-Snap-Tap/Free-Snap-Tap": "allow",
      "C:/Users/Wasiejen/AppData/Local/Temp/opencode": "allow"
    }
  },
  "snapshots": false,
  "compaction": {
    "auto": false,
      "keep": {
        "system": true,
        "tokens": 30000,
        "messages": 18
    },
    "buffer": 2000
  },
  "shell": "C:/Program Files/Git/bin/bash.exe",
  "provider": {
    "llama-swap": {
      "name": "llama-swap-v2",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.178.20:8033/v1"
      },
      "models": {
        "Qwen3.8-27B-Q2S-210K-MTP": {
          "name": "Qwen3.8-27B-Q2S-MTP",
          "limit": {
            "context": 210000,
            "output": 210000
          }
        },
        "Qwen3.8-27B-Q2S-128K-x2": {
          "name": "Qwen3.8-27B-Q2S-2Slots",
          "limit": {
            "context": 128000,
            "output": 128000
          }
        },


        // "Qwen3.8-27B-Q3XS-160K-MTP": {
        //   "name": "Qwen3.8-27B-Q3XS-MTP",
        //   "limit": {
        //     "context": 160000,
        //     "output": 160000
        //   }
        // },
        // "Qwen3.8-27B-Q3XS-160K-MTP:looprunner": {
        //   "name": "Qwen3.8-27B-Q3XS-MTP:looprunner",
        //   "limit": {
        //     "context": 160000,
        //     "output": 160000
        //   }
        // },


        "Qwen3.8-27B-Q3S-140K-MTP-Beellama": {
          "name": "Qwen3.8-27B-Q3S-MTP-Bee",
          "limit": {
            "context": 140000,
            "output": 140000
          }
        },
        "Qwen3.8-27B-Q3S-110K-MTP": {
          "name": "Qwen3.8-27B-Q3S-MTP",
          "limit": {
            "context": 110000,
            "output": 110000
          }
        },
        "Qwen3.8-27B-Q3S-160K": {
          "name": "Qwen3.8-27B-Q3S",
          "limit": {
            "context": 160000,
            "output": 160000
          }
        },


        "Gemma4-12B-Q4KM-UC-128K": {
          "name": "Gemma4-12B-Q4KM-UC",
          "limit": {
            "context": 262144,
            "output": 262144
          }
        },
        "Gemma4-12B-Q4KXL-MTP-128K": {
          "name": "Gemma4-12B-Q4KXL-MTP",
          "limit": {
            "context": 131072,
            "output": 131072
          }
        },
        // "CPU-Qwen3-0.6B": {
        //   "name": "CPU-Qwen3-0.6B",
        //   "limit": {
        //     "context": 32000,
        //     "output": 32000
        //   }
        // },
        // "CPU-Gemma4-E2B": {
        //   "name": "CPU-Gemma4-E2B",
        //   "limit": {
        //     "context": 32000,
        //     "output": 32000
        //   }
        // },
        // "CPU-Qwen3.5-4B": {
        //   "name": "CPU-Qwen3.5-4B",
        //    "limit": {
        //     "context": 16384,
        //     "output": 16384
        //   }
        // }
      }
    }
  },
  "references": {
    "scratchpad": {
      "path": "C:/Users/Wasiejen/AppData/Local/Temp/opencode",
      "description": "Local windows temporary directory for intermediate agent outputs"
    }
  },
  "subagent_depth": 2,
  "agent": {
    // when no compaction model is set, then the session own model will be used for compaction
    // "compaction": {
    //   "model": "llama-swap/Gemma4-12B-Q4KXL-MTP-128K",
    //   "temperature": 0.1
    // },
    "looprunner_Q3S_160K": {
      "description": "Just restarts the Planner in autonomous mode",
      "mode": "primary",
      "model": "llama-swap/Qwen3.8-27B-Q3S-160K",
      "temperature": 0.1, // set a bit higher - was really a bit easy to confuse with low temp
      "prompt": "{file:./.opencode/agent/prompts/agents/prompt_agent_looprunner.md}",
      "tools": {
        "*": true,
        "write_file": false,
        "edit": false,
        "bash": false,
        "block_transfer": false,
      },
      "permission": {
        "*": "deny",
        "task": "allow",
        "read": {
          "*": "deny",
          ".opencode/loop/**": "allow",
          ".opencode/loop": "allow",
          ".opencode/archive/loop/**": "allow",
          ".opencode/archive/loop": "allow",
          ".opencode/agent/prompts/agent_readme_loop.md": "allow",
          ".opencode/agent/prompts/agent_readme_post_compaction.md": "allow",
          ".opencode/temp/ctx.log": "allow",
          ".opencode/agent/prompts/skill/skill_autorun_summary.md": "allow",
          "opencode.jsonc": "allow",
        },
        "list_dir": "allow",
        "glob": "allow",
        "loop_log" : "allow",
        "compact_memory" : "allow",
      },
      "options": {
        "load_project_docs": false,
        "load_agents_md": false,
        "load_workspace_tree": false
      }
    },
    "planner_Q3S_160K": {
      "description": "plans tasks and delegates to sub-agents: very high intelligence, speedrating 48, 160k context, very high precision, highest general knowledge: best for very complex coding and code review work",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-Q3S-160K",
      "prompt": "{file:./.opencode/agent/prompts/agents/prompt_agent_planner.md}\n{file:.opencode/agent/memory/planner/destilled_mem.md}",
      // "prompt": "{file:./prompts/base.txt}\n{file:./prompts/rules.txt}\n{file:./prompts/examples.txt}"
      "temperature": 1.0,
      "permission": {
        "task": "allow",
        "edit": {
          "*": "allow",
          ".git/**": "deny",
          ".github/**": "deny"
        },
        "bash": "allow",
        "webfetch": "allow"
      },
      "color": "accent"
    },
    "worker_Q3S_160K": {
      "description": "very high intelligence, speedrating 48, 160k context, very high precision, highest general knowledge: best for very complex coding and code review work",
      "mode": "all",
      "model": "llama-swap/Qwen3.8-27B-Q3S-160K",
